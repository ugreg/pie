#!/usr/bin/env sh

# Security pre-commit hook
# Tools needed:
#   brew install trufflehog
#   brew install semgrep

# Exit on first failure
set -e

echo "Running security checks..."
echo ""

echo "[1/3] npm audit"
if npm audit --json 2>/dev/null | jq -r '[.vulnerabilities // [] | .[] | select(.severity == "critical" or .severity == "high")] | length' 2>/dev/null | grep -q "0"; then
    echo "  [OK] No critical/high vulnerabilities"
else
    echo "  [FAIL] CRITICAL: Found vulnerabilities!"
    npm audit
    exit 1
fi

echo "[2/3] trufflehog looking for secrets"
if command -v trufflehog &> /dev/null; then
    REPO_PATH="file://$(pwd)"
    TRUFFLE_OUTPUT=$(trufflehog git "$REPO_PATH" --json --only-verified 2>&1)
    
    echo "$TRUFFLE_OUTPUT" | while read -r line; do
        echo "$line" | jq -c -r '[(.level // ""), (.msg // ""), (.verified_secrets // "N/A")] | join(" | ")' 2>/dev/null || echo "$line"
    done
    
    SECRET_COUNT=$(echo "$TRUFFLE_OUTPUT" | jq -s '[.[].verified_secrets // 0] | add // 0' 2>/dev/null || echo "0")
    if [ "$SECRET_COUNT" = "0" ]; then
        echo "  [OK] No verified secrets"
    else
        echo "  [FAIL] VERIFIED SECRETS FOUND!"
        echo "$TRUFFLE_OUTPUT"
        exit 1
    fi
else
    echo "  [SKIP] trufflehog not installed, skipping"
    echo "     brew install trufflehog"
fi

echo "[3/3] semgrep looking for code vulnerabilities..."
if command -v semgrep &> /dev/null; then
    SEMGREP_OUTPUT=$(semgrep --config=auto --quiet --exclude=node_modules --exclude=.git . 2>&1)
    
    if echo "$SEMGREP_OUTPUT" | grep -q "Blocking"; then
        echo "  [FAIL] Semgrep found issues!"
        echo "$SEMGREP_OUTPUT"
        exit 1
    else
        echo "  [OK] Code looks clean"
    fi
else
    echo "  [SKIP] semgrep not installed, skipping"
    echo "     brew install semgrep"
fi

echo ""
echo "[OK] All security checks passed!"
