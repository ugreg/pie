{
  "ask": {
    "tools": [
      "edit",
      "write"
    ],
  },
  "allow": {
    "tools": [
      "find",
      "grep",
      "ls",
      "read",
      "code_search",
      "fetch_content",
      "get_search_content",
      "web_search"
    ],
  },
  "deny": {
    "bash git *",
    "bash npm *",
    "bash rm *",
    "bash dd *",
    "bash kill *",
    "bash killall *",
    "bash nc *",
    "bash mv *"
  },
  "paths": []
}
